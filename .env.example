# PostgreSQL container. Copy this file to .env and replace the password locally.
POSTGRES_DB=bidachat
POSTGRES_USER=bidachat
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Backend-only connection string. Match the values above when running locally.
APP_ENV=development
# Puerto local de FastAPI para desarrollo. Producción solo publica Nginx.
BACKEND_PORT=8000
# Puerto de Nginx en 127.0.0.1 del host. Use uno libre en el VPS.
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://bidachat:replace_me@localhost:5433/bidachat
SESSION_TTL_MINUTES=480
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI answer provider. Choose a Responses API model available to you;
# image queries require a model with vision support. Keep the key backend-only.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenRouter answer provider. Use a model slug available through your
# OpenRouter account; image queries require a vision-capable model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional public URL sent to OpenRouter for request attribution.
OPENROUTER_SITE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
WIDGET_ALLOWED_ORIGINS=

# Fixed RAG profile. Changing the model requires re-embedding the full corpus;
# changing dimensions also requires a schema migration.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_DIMENSIONS=768

# Backend-only Ollama endpoint. The database stores provider/model names, not URLs.
OLLAMA_BASE_URL=http://ollama:11434
# Selects the deployment profile: cpu or gpu. GPU requires the NVIDIA Container Toolkit.
OLLAMA_ACCELERATION=cpu
# CPU hosts should keep one model loaded and one concurrent request.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# Modelo visual local: necesario para describir fuentes PNG, JPEG y WebP.
OLLAMA_MODEL=qwen3-vl:2b-instruct
# Global source-image description profile. Defaults to OLLAMA_MODEL when the
# provider is ollama and VISION_MODEL is empty. External AI requires its API key.
VISION_PROVIDER=ollama
VISION_MODEL=
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_TIMEOUT_SECONDS=600

# Required in both Compose files. Initial values fit the development runtime
# that exposes 16 CPUs and 7.7 GiB RAM; the combined memory ceilings are below
# 6 GiB. Adapt them to model size and other workloads on each host before use.
# CPU values are numbers; memory uses Docker units such as 512m or 2g.
OLLAMA_CPU_LIMIT=3
OLLAMA_MEMORY_LIMIT=3g
BACKEND_CPU_LIMIT=1.5
BACKEND_MEMORY_LIMIT=1g
FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_LIMIT=768m
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=128m
DATABASE_CPU_LIMIT=1
DATABASE_MEMORY_LIMIT=1g

# Private document storage, never served as public static files.
DOCUMENT_STORAGE_PATH=./storage/documents
DOCUMENT_MAX_SIZE_BYTES=20971520

# El navegador usa el mismo origen de Nginx para /api/v1; no necesita URL pública separada.
